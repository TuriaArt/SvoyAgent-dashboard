# SvoyAgent-Dashboard — local run configuration example.
# Copy relevant lines into your shell environment; do not commit a real .env file.

PORT=3001
DASHBOARD_AUTH=off

# Recipes (SvoyAgentOS's equivalent of iva's "skills") default to
# %LOCALAPPDATA%\Meridian\svoyagent\recipes automatically — override only if
# your SvoyAgentOS install uses a non-default SVOYAGENT_RECIPES_DIR.
# AGENT_SKILLS_DIR=C:\Users\you\AppData\Local\Meridian\svoyagent\recipes
